-- ============================================================================
--  PRISM  |  UI LIBRARY
-- ============================================================================
--  Standalone script hub UI with a crystal intro.
--
--  INTRO SEQUENCE  (CreateWindow{ Intro = true }, the default)
--    1. Screen dims + game blurs.
--    2. Crystal shards fly in from off-screen and converge on the centre.
--    3. The gem wireframe draws itself edge by edge, then flashes.
--    4. Title letters drop in, a loading bar fills through status steps.
--    5. Window fades in, the gem winds up, arcs across the screen trailing
--       sparks and lands in the logo slot in the window's top-left corner.
--
--  The intro runs in its own thread. CreateWindow returns immediately so you
--  can build tabs while it plays; they're hidden until the window fades in.
--
--  The logo is drawn with plain Frames (rotated lines), so there are no image
--  asset ids to get moderated or fail to load.
--
--  OBJECT CHAIN
--    Prism:CreateWindow{}   -> Window
--    Window:Tab{}           -> Tab
--    Tab:Section{}          -> Section
--    Section:Toggle{} etc.  -> Element (:Set(), :Get(), .Value)
--
--  See Example.lua for every element.
-- ============================================================================

local cloneref = cloneref or function(o) return o end
local function svc(name) return cloneref(game:GetService(name)) end

local Players          = svc("Players")
local TweenService     = svc("TweenService")
local UserInputService = svc("UserInputService")
local RunService       = svc("RunService")
local Lighting         = svc("Lighting")
local CoreGui          = svc("CoreGui")
local HttpService      = svc("HttpService")

local LocalPlayer = Players.LocalPlayer

local Prism = {
    Version = "1.0.0",
    Flags   = {},
}

-- ============================================================================
--  THEME
-- ============================================================================
local Theme = {
    Background   = Color3.fromRGB(11, 10, 18),
    Sidebar      = Color3.fromRGB(15, 14, 25),
    Panel        = Color3.fromRGB(19, 18, 31),
    Element      = Color3.fromRGB(26, 24, 41),
    ElementHover = Color3.fromRGB(34, 32, 54),
    Stroke       = Color3.fromRGB(44, 40, 70),
    Text         = Color3.fromRGB(238, 236, 252),
    SubText      = Color3.fromRGB(152, 147, 184),
    Muted        = Color3.fromRGB(96, 91, 128),
    Accent       = Color3.fromRGB(170, 125, 255),

    -- Light split through the prism: pink -> violet -> blue -> cyan.
    Spectrum = {
        Color3.fromRGB(255, 110, 199),
        Color3.fromRGB(170, 125, 255),
        Color3.fromRGB(96, 165, 255),
        Color3.fromRGB(94, 234, 212),
    },
}
Prism.Theme = Theme

local function spectrumSequence()
    local s = Theme.Spectrum
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0,    s[1]),
        ColorSequenceKeypoint.new(0.35, s[2]),
        ColorSequenceKeypoint.new(0.7,  s[3]),
        ColorSequenceKeypoint.new(1,    s[4]),
    })
end

local function randomSpectrum()
    return Theme.Spectrum[math.random(1, #Theme.Spectrum)]
end

-- ============================================================================
--  HELPERS
-- ============================================================================
local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then inst[k] = v end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if props and props.Parent then inst.Parent = props.Parent end
    return inst
end

local function corner(r)
    return new("UICorner", { CornerRadius = r == "full" and UDim.new(1, 0) or UDim.new(0, r) })
end

local function stroke(color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    })
end

local function padding(t, b, l, r)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, t), PaddingBottom = UDim.new(0, b or t),
        PaddingLeft = UDim.new(0, l or t), PaddingRight = UDim.new(0, r or l or t),
    })
end

local function tween(obj, time, props, style, dir)
    local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end

local function lerp(a, b, t) return a + (b - a) * t end

local function safeCall(cb, ...)
    if typeof(cb) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(cb, table.unpack(args, 1, args.n))
        if not ok then warn("[Prism] callback error: " .. tostring(err)) end
    end)
end

local function formatNumber(v)
    if v % 1 == 0 then return tostring(v) end
    return (string.format("%.2f", v):gsub("0+$", ""))
end

-- Spectrum gradients that slowly rotate, and per-frame tickers (sparkle
-- twinkle). Weak keys so destroyed UI drops out on its own.
local animatedGradients = setmetatable({}, { __mode = "k" })
local tickers = setmetatable({}, { __mode = "k" })

local function spectralGradient(parent, speed)
    local g = new("UIGradient", { Color = spectrumSequence(), Rotation = math.random(0, 359), Parent = parent })
    animatedGradients[g] = speed or 40
    return g
end

RunService.Heartbeat:Connect(function(dt)
    for g, speed in pairs(animatedGradients) do
        g.Rotation = (g.Rotation + dt * speed) % 360
    end
    local t = os.clock()
    for owner, fn in pairs(tickers) do
        fn(t, owner)
    end
end)

local function guiParent(gui)
    local ok = pcall(function()
        gui.Parent = (gethui and gethui()) or CoreGui
    end)
    if not ok or not gui.Parent then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
end

local function isMouseOrTouch(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

-- ============================================================================
--  CRYSTAL LOGO
-- ============================================================================
--  A cut gem in a 120x120 design space. Scale it with the holder's UIScale.
--
--         a----m----b            table
--        / \  / \  / \
--       c---f-----g---d          girdle
--        \   \   /   /
--         \   \ /   /
--           \  e  /              point
-- ============================================================================
local LOGO_SIZE = 120

local LOGO_POINTS = {
    a = Vector2.new(36, 20),  m = Vector2.new(60, 20),  b = Vector2.new(84, 20),
    c = Vector2.new(12, 44),  f = Vector2.new(44, 44),  g = Vector2.new(76, 44),
    d = Vector2.new(108, 44), e = Vector2.new(60, 104),
}

-- Draw order: outline first, then the inner facets.
local LOGO_EDGES = {
    { "c", "a" }, { "a", "b" }, { "b", "d" }, { "d", "e" }, { "e", "c" },
    { "c", "d" }, { "a", "f" }, { "f", "m" }, { "m", "g" }, { "g", "b" },
    { "f", "e" }, { "g", "e" },
}

local function buildLogo(parent, opts)
    opts = opts or {}
    local hidden = opts.Hidden
    local thickness = opts.Thickness or 3

    local holder = new("Frame", {
        Name = "PrismLogo",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(LOGO_SIZE, LOGO_SIZE),
        BackgroundTransparency = 1,
        ZIndex = opts.ZIndex or 1,
        Parent = parent,
    })
    local scale = new("UIScale", { Scale = opts.Scale or 1, Parent = holder })

    local logo = { Holder = holder, Scale = scale, Lines = {}, Sparkles = {}, Glows = {} }

    -- Soft inner light: stacked circles fake a radial glow.
    for i = 1, 4 do
        local size = 30 + i * 18
        local glow = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(60, 56),
            Size = UDim2.fromOffset(size, size),
            BackgroundColor3 = Theme.Spectrum[2],
            BackgroundTransparency = hidden and 1 or (0.8 + i * 0.04),
            BorderSizePixel = 0,
            Parent = holder,
        }, { corner("full") })
        glow:SetAttribute("Target", 0.8 + i * 0.04)
        table.insert(logo.Glows, glow)
    end

    -- Faint crystal body behind the wireframe.
    logo.Body = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(60, 58),
        Size = UDim2.fromOffset(58, 58),
        Rotation = 45,
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = hidden and 1 or 0.86,
        BorderSizePixel = 0,
        Parent = holder,
    }, { corner(4) })
    spectralGradient(logo.Body, 25)

    local function makeLine(p1, p2, thick, transparency)
        local delta = p2 - p1
        local length = delta.Magnitude
        local mid = (p1 + p2) / 2
        local line = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = hidden and UDim2.fromOffset(p1.X, p1.Y) or UDim2.fromOffset(mid.X, mid.Y),
            Size = hidden and UDim2.fromOffset(0, thick) or UDim2.fromOffset(length, thick),
            Rotation = math.deg(math.atan2(delta.Y, delta.X)),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = transparency,
            BorderSizePixel = 0,
            Parent = holder,
        }, { corner("full") })
        spectralGradient(line, 60)
        return { Frame = line, From = p1, Mid = mid, Length = length, Glow = transparency > 0 }
    end

    for _, edge in ipairs(LOGO_EDGES) do
        local p1, p2 = LOGO_POINTS[edge[1]], LOGO_POINTS[edge[2]]
        local glow = makeLine(p1, p2, thickness * 3, 0.78)
        local core = makeLine(p1, p2, thickness, 0)
        table.insert(logo.Lines, { Core = core, Glow = glow })
    end

    -- Sparkles on the vertices that twinkle.
    for _, key in ipairs({ "a", "b", "c", "d", "e", "m" }) do
        local p = LOGO_POINTS[key]
        local sparkle = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(p.X, p.Y),
            Size = hidden and UDim2.fromOffset(0, 0) or UDim2.fromOffset(7, 7),
            Rotation = 45,
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            Parent = holder,
        })
        sparkle:SetAttribute("Phase", math.random() * math.pi * 2)
        table.insert(logo.Sparkles, sparkle)
    end

    tickers[holder] = function(t)
        if not holder.Parent then
            tickers[holder] = nil
            return
        end
        for _, s in ipairs(logo.Sparkles) do
            s.BackgroundTransparency = 0.35 + 0.55 * (0.5 + 0.5 * math.sin(t * 3 + s:GetAttribute("Phase")))
        end
    end

    function logo:SetThickness(core)
        for _, pair in ipairs(self.Lines) do
            pair.Core.Frame.Size = UDim2.fromOffset(pair.Core.Frame.Size.X.Offset, core)
            pair.Glow.Frame.Size = UDim2.fromOffset(pair.Glow.Frame.Size.X.Offset, core * 3)
        end
    end

    return logo
end

Prism.BuildLogo = buildLogo

-- ============================================================================
--  NOTIFICATIONS
-- ============================================================================
local notifyGui, notifyHolder

local function ensureNotifyHolder()
    if notifyHolder and notifyHolder.Parent then return notifyHolder end
    notifyGui = new("ScreenGui", {
        Name = "PrismNotifications",
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        DisplayOrder = 1000,
    })
    guiParent(notifyGui)
    notifyHolder = new("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -16, 1, -16),
        Size = UDim2.new(0, 290, 1, -32),
        BackgroundTransparency = 1,
        Parent = notifyGui,
    }, {
        new("UIListLayout", {
            Padding = UDim.new(0, 8),
            VerticalAlignment = Enum.VerticalAlignment.Bottom,
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })
    return notifyHolder
end

local notifyOrder = 0

function Prism:Notify(opts)
    opts = opts or {}
    local holder = ensureNotifyHolder()
    local duration = opts.Duration or 4
    notifyOrder += 1

    local wrapper = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder = notifyOrder,
        Parent = holder,
    })

    local card = new("Frame", {
        Position = UDim2.fromOffset(320, 0),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = wrapper,
    }, {
        corner(8),
        stroke(Theme.Stroke),
        padding(10, 14, 16, 12),
        new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }),
    })

    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = opts.Title or "Prism",
        TextColor3 = Theme.Text,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 1,
        Parent = card,
    })
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = opts.Content or "",
        TextColor3 = Theme.SubText,
        TextSize = 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = 2,
        Parent = card,
    })

    -- Accent bar on the left and timer along the bottom sit outside the list
    -- layout by living in the wrapper, on top of the card.
    local accent = new("Frame", {
        Position = UDim2.fromOffset(320, 0),
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = wrapper,
    }, { corner(2) })
    spectralGradient(accent, 0).Rotation = 90

    local timer = new("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 320, 1, 0),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = wrapper,
    })
    spectralGradient(timer, 0).Rotation = 0

    tween(card, 0.45, { Position = UDim2.fromOffset(0, 0) })
    tween(accent, 0.45, { Position = UDim2.fromOffset(0, 0) })
    tween(timer, 0.45, { Position = UDim2.new(0, 0, 1, 0) })
    task.delay(0.45, function()
        tween(timer, duration, { Size = UDim2.new(0, 0, 0, 2) }, Enum.EasingStyle.Linear)
    end)

    task.delay(duration + 0.45, function()
        tween(card, 0.35, { Position = UDim2.fromOffset(320, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tween(accent, 0.35, { Position = UDim2.fromOffset(320, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tween(timer, 0.35, { Position = UDim2.new(0, 320, 1, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.wait(0.35)
        wrapper.AutomaticSize = Enum.AutomaticSize.None
        wrapper.Size = UDim2.new(1, 0, 0, wrapper.AbsoluteSize.Y)
        tween(wrapper, 0.25, { Size = UDim2.new(1, 0, 0, 0) }).Completed:Wait()
        wrapper:Destroy()
    end)
end

-- ============================================================================
--  INTRO
-- ============================================================================
local function playIntro(window, opts)
    local gui = window.Gui
    local viewport = gui.AbsoluteSize
    if viewport.X == 0 then viewport = workspace.CurrentCamera.ViewportSize end

    local START_SCALE = 1.5
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.42)

    -- 1. Dim + blur ---------------------------------------------------------
    local overlay = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.fromRGB(5, 4, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 50,
        Parent = gui,
    })
    local blur
    pcall(function()
        blur = new("BlurEffect", { Name = "PrismBlur", Size = 0, Parent = Lighting })
    end)
    tween(overlay, 0.5, { BackgroundTransparency = 0.2 })
    if blur then tween(blur, 0.5, { Size = 20 }) end

    local fx = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 55, Parent = gui })

    local logo = buildLogo(gui, { Hidden = true, Scale = START_SCALE, ZIndex = 60 })
    logo.Holder.Position = UDim2.fromOffset(center.X, center.Y)

    local function vertexOnScreen(p)
        return center + (p - Vector2.new(LOGO_SIZE / 2, LOGO_SIZE / 2)) * START_SCALE
    end

    task.wait(0.2)

    -- 2. Shards converge ----------------------------------------------------
    local vertexList = {}
    for _, p in pairs(LOGO_POINTS) do table.insert(vertexList, p) end

    for _ = 1, 34 do
        local angle = math.random() * math.pi * 2
        local dist = math.random(280, 560)
        local from = center + Vector2.new(math.cos(angle), math.sin(angle)) * dist
        local to = vertexOnScreen(vertexList[math.random(1, #vertexList)])
        local size = math.random(5, 10)
        local shard = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(from.X, from.Y),
            Size = UDim2.fromOffset(size, size * 1.6),
            Rotation = math.random(0, 360),
            BackgroundColor3 = randomSpectrum(),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Parent = fx,
        })
        task.delay(math.random() * 0.5, function()
            local travel = 0.6 + math.random() * 0.35
            tween(shard, 0.15, { BackgroundTransparency = 0 })
            tween(shard, travel, { Position = UDim2.fromOffset(to.X, to.Y), Rotation = shard.Rotation + 220 }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
            task.wait(travel)
            tween(shard, 0.25, { Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1 })
            task.wait(0.25)
            shard:Destroy()
        end)
    end

    task.wait(0.75)

    -- 3. Wireframe draws in --------------------------------------------------
    for i, pair in ipairs(logo.Lines) do
        task.delay((i - 1) * 0.07, function()
            for _, part in ipairs({ pair.Glow, pair.Core }) do
                local f = part.Frame
                tween(f, 0.32, {
                    Position = UDim2.fromOffset(part.Mid.X, part.Mid.Y),
                    Size = UDim2.fromOffset(part.Length, f.Size.Y.Offset),
                }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            end
        end)
    end
    task.wait(#logo.Lines * 0.07 + 0.25)

    -- Facets light up + flash ring
    tween(logo.Body, 0.6, { BackgroundTransparency = 0.86 })
    for _, glow in ipairs(logo.Glows) do
        tween(glow, 0.6, { BackgroundTransparency = glow:GetAttribute("Target") })
    end
    for i, s in ipairs(logo.Sparkles) do
        task.delay(i * 0.04, function()
            tween(s, 0.35, { Size = UDim2.fromOffset(7, 7) }, Enum.EasingStyle.Back)
        end)
    end

    local ring = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(center.X, center.Y),
        Size = UDim2.fromOffset(60, 60),
        BackgroundTransparency = 1,
        ZIndex = 58,
        Parent = fx,
    }, { corner("full") })
    local ringStroke = stroke(Color3.new(1, 1, 1), 3, 0)
    ringStroke.Parent = ring
    spectralGradient(ringStroke, 120)
    tween(ring, 0.8, { Size = UDim2.fromOffset(460, 460) })
    tween(ringStroke, 0.8, { Transparency = 1, Thickness = 1 })
    tween(logo.Scale, 0.12, { Scale = START_SCALE * 1.08 }).Completed:Wait()
    tween(logo.Scale, 0.4, { Scale = START_SCALE }, Enum.EasingStyle.Back)

    -- 4. Title + loading bar -------------------------------------------------
    local title = string.upper(opts.Title or "PRISM")
    local textBlock = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.fromOffset(center.X, center.Y + LOGO_SIZE * START_SCALE * 0.5 + 18),
        Size = UDim2.fromOffset(400, 120),
        BackgroundTransparency = 1,
        ZIndex = 60,
        Parent = gui,
    })
    local letterRow = new("Frame", {
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundTransparency = 1,
        Parent = textBlock,
    }, {
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })
    local letters = {}
    for i = 1, #title do
        local slot = new("Frame", {
            Size = UDim2.fromOffset(30, 46),
            BackgroundTransparency = 1,
            LayoutOrder = i,
            Parent = letterRow,
        })
        local letter = new("TextLabel", {
            Position = UDim2.fromOffset(0, -22),
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBlack,
            Text = title:sub(i, i),
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 40,
            TextTransparency = 1,
            Parent = slot,
        })
        spectralGradient(letter, 50)
        table.insert(letters, letter)
        task.delay((i - 1) * 0.06, function()
            tween(letter, 0.5, { Position = UDim2.fromOffset(0, 0), TextTransparency = 0 }, Enum.EasingStyle.Back)
        end)
    end

    local tagline = new("TextLabel", {
        Position = UDim2.fromOffset(0, 50),
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = opts.Tagline or "",
        TextColor3 = Theme.SubText,
        TextSize = 13,
        TextTransparency = 1,
        Parent = textBlock,
    })
    tween(tagline, 0.6, { TextTransparency = 0 })

    local track = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 82),
        Size = UDim2.fromOffset(220, 3),
        BackgroundColor3 = Theme.Stroke,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = textBlock,
    }, { corner("full") })
    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    }, { corner("full") })
    new("UIGradient", { Color = spectrumSequence(), Parent = fill })
    local status = new("TextLabel", {
        Position = UDim2.fromOffset(0, 92),
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = Theme.Muted,
        TextSize = 12,
        TextTransparency = 1,
        Parent = textBlock,
    })
    tween(track, 0.4, { BackgroundTransparency = 0 })
    tween(status, 0.4, { TextTransparency = 0 })

    local steps = opts.Steps or {
        "Refracting light",
        "Cutting facets",
        "Loading modules",
        "Ready",
    }
    for i, text in ipairs(steps) do
        status.Text = text
        tween(fill, 0.35, { Size = UDim2.fromScale(i / #steps, 1) }, Enum.EasingStyle.Quad)
        task.wait(0.4)
    end
    task.wait(0.15)

    -- 5. Hand off to the window ---------------------------------------------
    for i, letter in ipairs(letters) do
        task.delay((i - 1) * 0.03, function()
            tween(letter, 0.3, { TextTransparency = 1, Position = UDim2.fromOffset(0, -10) })
        end)
    end
    tween(tagline, 0.3, { TextTransparency = 1 })
    tween(status, 0.3, { TextTransparency = 1 })
    tween(track, 0.3, { BackgroundTransparency = 1 })
    tween(fill, 0.3, { BackgroundTransparency = 1 })

    tween(overlay, 0.7, { BackgroundTransparency = 1 })
    if blur then tween(blur, 0.7, { Size = 0 }) end
    window:_reveal(0.55)

    -- Wind-up before launch
    tween(logo.Scale, 0.22, { Scale = START_SCALE * 1.12 }, Enum.EasingStyle.Quad).Completed:Wait()

    -- Flight: quadratic bezier that arcs up and over to the logo slot, spinning
    -- and shrinking, line thickness growing so it stays crisp at small size.
    local slot = window.LogoSlot
    local fromScale = logo.Scale.Scale
    local fromPos = center
    local duration = 0.95
    local started = os.clock()
    local lastSpark = 0

    while true do
        local alpha = math.clamp((os.clock() - started) / duration, 0, 1)
        local e = TweenService:GetValue(alpha, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)

        local target = slot.AbsolutePosition + slot.AbsoluteSize / 2
        local endScale = slot.AbsoluteSize.X / LOGO_SIZE
        local control = Vector2.new(lerp(fromPos.X, target.X, 0.2), math.min(fromPos.Y, target.Y) - 160)
        local pos = fromPos * ((1 - e) ^ 2) + control * (2 * (1 - e) * e) + target * (e ^ 2)

        logo.Holder.Position = UDim2.fromOffset(pos.X, pos.Y)
        logo.Holder.Rotation = -360 * e
        logo.Scale.Scale = lerp(fromScale, endScale, e)
        logo:SetThickness(lerp(3, 5.5, e))

        if alpha > 0.04 and alpha < 0.96 and os.clock() - lastSpark > 0.016 then
            lastSpark = os.clock()
            local s = math.random(3, 7)
            local spark = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromOffset(pos.X + math.random(-6, 6), pos.Y + math.random(-6, 6)),
                Size = UDim2.fromOffset(s, s),
                Rotation = 45,
                BackgroundColor3 = randomSpectrum(),
                BorderSizePixel = 0,
                Parent = fx,
            })
            local drift = Vector2.new(math.random(-30, 30), math.random(-10, 40))
            tween(spark, 0.55, {
                Position = UDim2.fromOffset(pos.X + drift.X, pos.Y + drift.Y),
                Size = UDim2.fromOffset(0, 0),
                BackgroundTransparency = 1,
            }, Enum.EasingStyle.Quad)
            task.delay(0.6, function() spark:Destroy() end)
        end

        if alpha >= 1 then break end
        RunService.RenderStepped:Wait()
    end

    -- Landing: dock into the slot, pulse ring, little bounce. Design size, not
    -- AbsoluteSize, since the window's UIScale now applies to the logo too.
    local endScale = slot.Size.X.Offset / LOGO_SIZE
    logo.Holder.Rotation = 0
    logo.Holder.ZIndex = 5
    logo.Holder.Parent = slot
    logo.Holder.Position = UDim2.fromScale(0.5, 0.5)
    window.Logo = logo

    local pulse = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(slot.AbsoluteSize.X, slot.AbsoluteSize.X),
        BackgroundTransparency = 1,
        Parent = slot,
    }, { corner("full") })
    local pulseStroke = stroke(Color3.new(1, 1, 1), 2, 0)
    pulseStroke.Parent = pulse
    spectralGradient(pulseStroke, 120)
    tween(pulse, 0.6, { Size = UDim2.fromOffset(slot.AbsoluteSize.X * 2.4, slot.AbsoluteSize.X * 2.4) })
    tween(pulseStroke, 0.6, { Transparency = 1 })
    tween(logo.Scale, 0.1, { Scale = endScale * 1.18 }, Enum.EasingStyle.Quad).Completed:Wait()
    tween(logo.Scale, 0.45, { Scale = endScale }, Enum.EasingStyle.Back)

    task.wait(0.7)
    pulse:Destroy()
    overlay:Destroy()
    textBlock:Destroy()
    fx:Destroy()
    if blur then blur:Destroy() end
end

-- ============================================================================
--  ELEMENTS
-- ============================================================================
local Section = {}
Section.__index = Section

local function registerFlag(flag, element)
    if flag and flag ~= "" then Prism.Flags[flag] = element end
end

local function baseElement(section, height)
    local frame = new("Frame", {
        Size = UDim2.new(1, 0, 0, height or 34),
        BackgroundColor3 = Theme.Element,
        BorderSizePixel = 0,
        LayoutOrder = section:_nextOrder(),
        Parent = section.Container,
    }, { corner(6) })
    return frame
end

local function hitbox(parent)
    local hit = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 3,
        Parent = parent,
    })
    hit.MouseEnter:Connect(function() tween(parent, 0.2, { BackgroundColor3 = Theme.ElementHover }) end)
    hit.MouseLeave:Connect(function() tween(parent, 0.2, { BackgroundColor3 = Theme.Element }) end)
    return hit
end

local function elementLabel(parent, text, width)
    return new("TextLabel", {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -(width or 24), 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = text,
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent,
    })
end

function Section:_nextOrder()
    self._order += 1
    return self._order
end

