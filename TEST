            Parent = self.LogoSlot,
        }, { corner(2), stroke(Theme.Stroke, 1.5, 0.2) })
        for _, label in ipairs({ self.BrandTitle, self.BrandSubtitle }) do
            label.TextTransparency = 1
            label.Position -= UDim2.fromOffset(12, 0)
        end

        task.spawn(playIntro, self, {
            Title = opts.IntroTitle or opts.Title or "Prism",
            Tagline = opts.Tagline or "crystal clear scripting",
            Steps = opts.IntroSteps,
        })
    else
        local logo = buildLogo(self.LogoSlot, { Scale = self.LogoSlot.Size.X.Offset / LOGO_SIZE })
        logo.Holder.Position = UDim2.fromScale(0.5, 0.5)
        self.Logo = logo
    end

    return self
end

function Window:_reveal(time)
    self.Root.Visible = true
    tween(self.Main, time, { GroupTransparency = 0 })
    tween(self.Shadow, time, { ImageTransparency = SHADOW_TRANSPARENCY })
    tween(self.RootScale, time, { Scale = self.BaseScale }, Enum.EasingStyle.Back)
end

function Window:_revealBrand()
    for i, label in ipairs({ self.BrandTitle, self.BrandSubtitle }) do
        task.delay((i - 1) * 0.08, function()
            tween(label, 0.5, {
                TextTransparency = 0,
                Position = label.Position + UDim2.fromOffset(12, 0),
            })
        end)
    end
end

function Window:SetVisible(visible)
    self.Visible = visible
    if visible then
        self.RootScale.Scale = self.BaseScale * 0.96
        self:_reveal(0.3)
    else
        tween(self.Main, 0.25, { GroupTransparency = 1 })
        tween(self.Shadow, 0.25, { ImageTransparency = 1 })
        tween(self.RootScale, 0.25, { Scale = self.BaseScale * 0.96 }).Completed:Connect(function()
            if not self.Visible then self.Root.Visible = false end
        end)
    end
end

function Window:SetToggleKey(key)
    self.ToggleKey = key
    self.KeyHint.Text = key.Name
end

--  Window:Tab{ Name, Icon }
function Window:Tab(opts)
    opts = opts or {}
    local tab = setmetatable({ Window = self, Name = opts.Name or "Tab" }, Tab)

    local button = new("TextButton", {
        Size = UDim2.fromOffset(0, 34),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = #self.Tabs + 1,
        Parent = self.TabList,
    }, {
        corner(6),
        padding(0, 0, 12, 14),
        new("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
    })
    local buttonStroke = outline(1)
    buttonStroke.Parent = button

    local tabIcon
    if resolveIcon(opts.Icon) then
        tabIcon = icon(opts.Icon, 16, Theme.Muted, { LayoutOrder = 1, Parent = button })
    end
    local label = new("TextLabel", {
        Size = UDim2.fromOffset(0, 34),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        FontFace = Fonts.Medium,
        Text = tab.Name,
        TextColor3 = Theme.SubText,
        TextSize = 13,
        LayoutOrder = 2,
        Parent = button,
    })

    local page = new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Muted,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.Pages,
    }, { padding(18, 18, 18, 18) })

    local function column(x, w)
        return new("Frame", {
            Position = UDim2.new(x, x == 0 and 0 or 6, 0, 0),
            Size = UDim2.new(w, w == 1 and 0 or -6, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Parent = page,
        }, { new("UIListLayout", { Padding = UDim.new(0, 20), SortOrder = Enum.SortOrder.LayoutOrder }) })
    end
    if self.Columns == 2 then
        tab.Left, tab.Right = column(0, 0.5), column(0.5, 0.5)
    else
        tab.Left = column(0, 1)
        tab.Right = tab.Left
    end
    tab.Page, tab.Button = page, button

    function tab:_setActive(active)
        tween(button, 0.2, { BackgroundTransparency = active and 0 or 1 })
        tween(buttonStroke, 0.2, { Transparency = active and Theme.OutlineTransparency or 1 })
        tween(label, 0.2, { TextColor3 = active and Theme.Text or Theme.SubText })
        if tabIcon then tween(tabIcon, 0.2, { ImageColor3 = active and Theme.Accent or Theme.Muted }) end
        page.Visible = active
        if active then
            page.Position = UDim2.fromOffset(0, 8)
            tween(page, 0.3, { Position = UDim2.fromOffset(0, 0) })
        end
    end

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then tween(label, 0.15, { TextColor3 = Theme.Text }) end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then tween(label, 0.15, { TextColor3 = Theme.SubText }) end
    end)
    button.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(tab)
    if self.ActiveTab == tab then return end
    if self.ActiveTab then self.ActiveTab:_setActive(false) end
    self.ActiveTab = tab
    tab:_setActive(true)
end

-- Config --------------------------------------------------------------------
--  Saves every element created with a Flag to <ConfigFolder>/<name>.json.
function Window:SaveConfig(name)
    if not writefile then return false end
    local data = {}
    for flag, el in pairs(Prism.Flags) do
        local v = el.Value
        if typeof(v) == "EnumItem" then v = { __enum = v.Name } end
        data[flag] = v
    end
    if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
    writefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    return true
end

function Window:LoadConfig(name)
    local path = self.ConfigFolder .. "/" .. name .. ".json"
    if not (readfile and isfile and isfile(path)) then return false end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
    if not ok then return false end
    for flag, v in pairs(data) do
        local el = Prism.Flags[flag]
        if el and el.Set then
            if typeof(v) == "table" and v.__enum then v = Enum.KeyCode[v.__enum] end
            el:Set(v)
        end
    end
    return true
end

function Window:Destroy()
    tween(self.Main, 0.25, { GroupTransparency = 1 })
    tween(self.Shadow, 0.25, { ImageTransparency = 1 })
    tween(self.RootScale, 0.25, { Scale = self.BaseScale * 0.9 }).Completed:Wait()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    self.Gui:Destroy()
    local blur = Lighting:FindFirstChild("PrismBlur")
    if blur then blur:Destroy() end
end

return Prism
