        logo.Holder.Position = UDim2.fromScale(0.5, 0.5)
        self.Logo = logo
    end

    return self
end

function Window:_reveal(time)
    self.Root.Visible = true
    tween(self.Main, time, { GroupTransparency = 0 })
    tween(self.Border, time, { BackgroundTransparency = 0.45 })
    tween(self.RootScale, time, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Window:SetVisible(visible)
    self.Visible = visible
    if visible then
        self.RootScale.Scale = 0.96
        self:_reveal(0.3)
    else
        tween(self.Main, 0.25, { GroupTransparency = 1 })
        tween(self.Border, 0.25, { BackgroundTransparency = 1 })
        tween(self.RootScale, 0.25, { Scale = 0.96 }).Completed:Connect(function()
            if not self.Visible then self.Root.Visible = false end
        end)
    end
end

function Window:Tab(opts)
    opts = opts or {}
    local tab = setmetatable({ Window = self, Name = opts.Name or "Tab" }, Tab)

    local button = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Theme.Element,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = #self.Tabs + 1,
        Parent = self.TabList,
    }, { corner(7) })
    local indicator = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(3, 0),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = button,
    }, { corner("full") })
    spectralGradient(indicator, 0).Rotation = 90
    local label = new("TextLabel", {
        Position = UDim2.fromOffset(16, 0),
        Size = UDim2.new(1, -20, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = tab.Name,
        TextColor3 = Theme.SubText,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = button,
    })

    local page = new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        Parent = self.Pages,
    }, { padding(14, 14, 14, 14) })

    local function column(x)
        return new("Frame", {
            Position = UDim2.new(x, x == 0 and 0 or 6, 0, 0),
            Size = UDim2.new(0.5, -6, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Parent = page,
        }, { new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }) })
    end
    tab.Left, tab.Right = column(0), column(0.5)
    tab.Page, tab.Button = page, button

    function tab:_setActive(active)
        tween(button, 0.25, { BackgroundTransparency = active and 0 or 1 })
        tween(label, 0.25, { TextColor3 = active and Theme.Text or Theme.SubText, Position = UDim2.fromOffset(active and 20 or 16, 0) })
        tween(indicator, 0.3, { Size = UDim2.fromOffset(3, active and 16 or 0) }, Enum.EasingStyle.Back)
        page.Visible = active
        if active then
            page.Position = UDim2.fromOffset(0, 10)
            tween(page, 0.35, { Position = UDim2.fromOffset(0, 0) })
        end
    end

    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then tween(label, 0.2, { TextColor3 = Theme.Text }) end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then tween(label, 0.2, { TextColor3 = Theme.SubText }) end
    end)
    button.MouseButton1Click:Connect(function() self:SelectTab(tab) end)

    table.insert(self.Tabs, tab)
    if #self.Tabs == 1 then self:SelectTab(tab) end
    return tab
end

function Window:SelectTab(tab)
    if self.ActiveTab == tab then return end
    if self.ActiveTab then self.ActiveTab:_setActive(false) end
    self.ActiveTab = tab
    self.PageTitle.Text = tab.Name
    tab:_setActive(true)
end

-- Config --------------------------------------------------------------------
--  Saves every element created with a Flag to <ConfigFolder>/<name>.json.
function Window:SaveConfig(name)
    if not writefile then return false end
    local data = {}
    for flag, element in pairs(Prism.Flags) do
        local v = element.Value
        if typeof(v) == "EnumItem" then v = { __enum = v.Name } end
        data[flag] = v
    end
    if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
    writefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    return true
end

function Window:LoadConfig(name)
    local path = self.ConfigFolder .. "/" .. name .. ".json"
    if not (readfile and isfile and isfile(path)) then return false end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
    if not ok then return false end
    for flag, v in pairs(data) do
        local element = Prism.Flags[flag]
        if element and element.Set then
            if typeof(v) == "table" and v.__enum then v = Enum.KeyCode[v.__enum] end
            element:Set(v)
        end
    end
    return true
end

function Window:Destroy()
    tween(self.Main, 0.25, { GroupTransparency = 1 })
    tween(self.Border, 0.25, { BackgroundTransparency = 1 })
    tween(self.RootScale, 0.25, { Scale = 0.9 }).Completed:Wait()
    for _, c in ipairs(self._conns) do c:Disconnect() end
    self.Gui:Destroy()
    local blur = Lighting:FindFirstChild("PrismBlur")
    if blur then blur:Destroy() end
end

return Prism
