local Window = {}
Window.__index = Window

local function makeDraggable(handle, target, conns)
    local dragging, dragStart, startPos = false, nil, nil
    handle.InputBegan:Connect(function(input)
        if isMouseOrTouch(input) then
            dragging, dragStart, startPos = true, input.Position, target.Position
        end
    end)
    table.insert(conns, UserInputService.InputChanged:Connect(function(input)
        if dragging and isMove(input) then
            local delta = input.Position - dragStart
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
    table.insert(conns, UserInputService.InputEnded:Connect(function(input)
        if isMouseOrTouch(input) then dragging = false end
    end))
end

local SHADOW_TRANSPARENCY = 0.4

function Prism:CreateWindow(opts)
    opts = opts or {}
    local self = setmetatable({}, Window)
    self._conns = {}
    self.Tabs = {}
    self.Visible = true
    self.ToggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
    self.ConfigFolder = opts.ConfigFolder or "Prism"
    self.Columns = opts.Columns or 1
    local size = opts.Size or Vector2.new(560, 660)
    local width, height = size.X, size.Y
    local useIntro = opts.Intro ~= false

    local HEADER, TABBAR, FOOTER = 72, 52, 56

    local gui = new("ScreenGui", {
        Name = "Prism",
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        DisplayOrder = 999,
    })
    guiParent(gui)
    self.Gui = gui

    -- Root carries position (drag) and scale; the shadow sits behind Main.
    local root = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(width, height),
        BackgroundTransparency = 1,
        Parent = gui,
    })
    self.Root = root

    -- BaseScale shrinks the window to fit small screens. Every scale
    -- animation is relative to it.
    local camera = workspace.CurrentCamera
    local function fitScale()
        local viewport = camera.ViewportSize
        return math.min(1, (viewport.X - 40) / width, (viewport.Y - 40) / height)
    end
    self.BaseScale = fitScale()
    self.RootScale = new("UIScale", { Scale = self.BaseScale, Parent = root })
    table.insert(self._conns, camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        self.BaseScale = fitScale()
        if self.Visible then self.RootScale.Scale = self.BaseScale end
    end))

    self.Shadow = dropShadow(root, "Window")

    local main = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = root,
    }, { corner(10) })
    self.Main = main

    local function divider(y, parent)
