        PlaceholderColor3 = Theme.Muted,
        Text = opts.Default or "",
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = frame,
    }, { corner(4), padding(0, 0, 8, 8) })
    local boxStroke = stroke(Theme.Stroke)
    boxStroke.Parent = box

    local textbox = { Value = box.Text, Frame = frame }
    function textbox:Set(text, silent)
        self.Value = tostring(text)
        box.Text = self.Value
        if not silent then safeCall(opts.Callback, self.Value) end
