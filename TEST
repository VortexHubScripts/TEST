-- A row with no control: a title and body text.
function Section:Paragraph(opts)
    local row, _, title, desc = baseRow(self, {
        Name = opts.Title or "",
        Description = opts.Content or " ",
    }, UDim2.new(1, -14, 0, 0))
    return {
        Frame = row,
        Set = function(_, t, c)
            if t then title.Text = t end
            if c and desc then desc.Text = c end
        end,
    }
end

