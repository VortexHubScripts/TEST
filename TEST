-- Toggle --------------------------------------------------------------------
function Section:Toggle(opts)
    local frame = baseElement(self)
    elementLabel(frame, opts.Name or "Toggle", 70)

    local switch = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(36, 18),
        BackgroundColor3 = Theme.Stroke,
        BorderSizePixel = 0,
        Parent = frame,
    }, { corner("full") })
    local fill = new("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = switch,
    }, { corner("full") })
    spectralGradient(fill, 30)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = switch,
    }, { corner("full") })

    local toggle = { Value = false, Frame = frame }

    function toggle:Set(value, silent)
        self.Value = value and true or false
        tween(fill, 0.25, { BackgroundTransparency = self.Value and 0 or 1 })
        tween(knob, 0.25, { Position = UDim2.new(0, self.Value and 21 or 3, 0.5, 0) }, Enum.EasingStyle.Back)
        if not silent then safeCall(opts.Callback, self.Value) end
    end
    function toggle:Get() return self.Value end

    hitbox(frame).MouseButton1Click:Connect(function() toggle:Set(not toggle.Value) end)

    toggle:Set(opts.Default or false, true)
    if opts.Default then safeCall(opts.Callback, true) end
    registerFlag(opts.Flag, toggle)
    return toggle
end

-- Slider --------------------------------------------------------------------
function Section:Slider(opts)
    local min, max = opts.Min or 0, opts.Max or 100
    local increment = opts.Increment or 1
    local suffix = opts.Suffix or ""

    local frame = baseElement(self, 48)
    new("TextLabel", {
        Position = UDim2.fromOffset(12, 6),
        Size = UDim2.new(1, -90, 0, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamMedium,
        Text = opts.Name or "Slider",
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = frame,
    })
    local valueLabel = new("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 6),
        Size = UDim2.fromOffset(70, 18),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextColor3 = Theme.SubText,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = frame,
    })
    local track = new("Frame", {
        Position = UDim2.new(0, 12, 1, -15),
        Size = UDim2.new(1, -24, 0, 5),
        BackgroundColor3 = Theme.Stroke,
        BorderSizePixel = 0,
        Parent = frame,
    }, { corner("full") })
    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    }, { corner("full") })
    new("UIGradient", { Color = spectrumSequence(), Parent = fill })
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(12, 12),
        BackgroundColor3 = Theme.Text,
        BorderSizePixel = 0,
        ZIndex = 2,
        Parent = track,
    }, { corner("full") })

    local slider = { Value = min, Frame = frame }

    function slider:Set(value, silent)
        value = math.clamp(value, min, max)
        value = math.floor(value / increment + 0.5) * increment
        value = math.clamp(tonumber(formatNumber(value)), min, max)
        local changed = value ~= self.Value
        self.Value = value
        local rel = (max == min) and 0 or (value - min) / (max - min)
        tween(fill, 0.12, { Size = UDim2.fromScale(rel, 1) }, Enum.EasingStyle.Quad)
        tween(knob, 0.12, { Position = UDim2.fromScale(rel, 0.5) }, Enum.EasingStyle.Quad)
        valueLabel.Text = formatNumber(value) .. suffix
        if changed and not silent then safeCall(opts.Callback, value) end
    end
    function slider:Get() return self.Value end

    local dragging = false
    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        slider:Set(lerp(min, max, rel))
    end

    local hit = hitbox(frame)
    hit.InputBegan:Connect(function(input)
        if isMouseOrTouch(input) then
            dragging = true
            update(input.Position.X)
        end
    end)
    table.insert(self.Window._conns, UserInputService.InputChanged:Connect(function(input)
        if dragging and isMove(input) then update(input.Position.X) end
    end))
    table.insert(self.Window._conns, UserInputService.InputEnded:Connect(function(input)
        if isMouseOrTouch(input) then dragging = false end
    end))

    slider.Value = nil
    slider:Set(opts.Default or min, true)
    if opts.Default then safeCall(opts.Callback, slider.Value) end
    registerFlag(opts.Flag, slider)
    return slider
end

-- Dropdown ------------------------------------------------------------------
function Section:Dropdown(opts)
    local multi = opts.Multi or false
    local frame = baseElement(self)
    frame.ClipsDescendants = true

    local header = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = frame })
    elementLabel(header, opts.Name or "Dropdown", 150)
    local valueLabel = new("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -30, 0, 0),
        Size = UDim2.new(0.5, -20, 1, 0),
        BackgroundTransparency = 1,
        Font = Enum.Font.Gotham,
        TextColor3 = Theme.SubText,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = header,
    })
    local arrow = new("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(14, 14),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        Text = "▾",
        TextColor3 = Theme.Muted,
        TextSize = 14,
        Parent = header,
    })
    local hit = hitbox(frame)
    hit.Size = UDim2.new(1, 0, 0, 34)

    local list = new("ScrollingFrame", {
        Position = UDim2.fromOffset(6, 36),
        Size = UDim2.new(1, -12, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Parent = frame,
    }, { new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local dropdown = { Value = multi and {} or nil, Options = {}, Open = false, Frame = frame }
    local buttons = {}

    local function isSelected(option)
        if multi then return table.find(dropdown.Value, option) ~= nil end
        return dropdown.Value == option
    end

    local function render()
        if multi then
            valueLabel.Text = #dropdown.Value > 0 and table.concat(dropdown.Value, ", ") or "None"
        else
            valueLabel.Text = dropdown.Value ~= nil and tostring(dropdown.Value) or "None"
        end
        for option, button in pairs(buttons) do
            local on = isSelected(option)
            tween(button, 0.15, {
                BackgroundTransparency = on and 0 or 1,
                TextColor3 = on and Theme.Text or Theme.SubText,
            })
        end
    end

    local function listHeight()
        return math.min(#dropdown.Options, 6) * 26
    end

    function dropdown:SetOpen(open)
        self.Open = open
        tween(arrow, 0.25, { Rotation = open and 180 or 0 })
        tween(list, 0.25, { Size = UDim2.new(1, -12, 0, open and listHeight() or 0) })
        tween(frame, 0.25, { Size = UDim2.new(1, 0, 0, open and (40 + listHeight()) or 34) })
    end

    function dropdown:Set(value, silent)
        if multi then
            self.Value = typeof(value) == "table" and table.clone(value) or { value }
        else
            self.Value = value
        end
        render()
        if not silent then safeCall(opts.Callback, self.Value) end
    end
    function dropdown:Get() return self.Value end

    function dropdown:Refresh(options)
        self.Options = options or {}
        for _, b in pairs(buttons) do b:Destroy() end
        table.clear(buttons)
        for i, option in ipairs(self.Options) do
            local button = new("TextButton", {
                Size = UDim2.new(1, -4, 0, 24),
                BackgroundColor3 = Theme.ElementHover,
                BackgroundTransparency = 1,
                AutoButtonColor = false,
                Font = Enum.Font.Gotham,
                Text = tostring(option),
                TextColor3 = Theme.SubText,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                LayoutOrder = i,
                Parent = list,
            }, { corner(4), padding(0, 0, 8, 8) })
            buttons[option] = button
            button.MouseButton1Click:Connect(function()
                if multi then
                    local idx = table.find(dropdown.Value, option)
                    if idx then table.remove(dropdown.Value, idx) else table.insert(dropdown.Value, option) end
                    render()
                    safeCall(opts.Callback, dropdown.Value)
                else
                    dropdown:Set(option)
                    dropdown:SetOpen(false)
                end
            end)
        end
        if multi then
            for i = #self.Value, 1, -1 do
                if not table.find(self.Options, self.Value[i]) then table.remove(self.Value, i) end
            end
        elseif self.Value ~= nil and not table.find(self.Options, self.Value) then
            self.Value = nil
        end
        render()
        if self.Open then self:SetOpen(true) end
    end

    hit.MouseButton1Click:Connect(function() dropdown:SetOpen(not dropdown.Open) end)

    dropdown:Refresh(opts.Options or {})
    if opts.Default ~= nil then dropdown:Set(opts.Default) end
    registerFlag(opts.Flag, dropdown)
    return dropdown
end

-- Textbox -------------------------------------------------------------------
function Section:Textbox(opts)
    local frame = baseElement(self)
    elementLabel(frame, opts.Name or "Textbox", 160)
    local box = new("TextBox", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(130, 24),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        PlaceholderText = opts.Placeholder or "Type here...",
        PlaceholderColor3 = Theme.Muted,
        Text = opts.Default or "",
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Parent = frame,
    }, { corner(4), padding(0, 0, 8, 8) })
    local boxStroke = stroke(Theme.Stroke)
    boxStroke.Parent = box

    local textbox = { Value = box.Text, Frame = frame }
    function textbox:Set(text, silent)
        self.Value = tostring(text)
        box.Text = self.Value
        if not silent then safeCall(opts.Callback, self.Value) end
    end
    function textbox:Get() return self.Value end

    box.Focused:Connect(function() tween(boxStroke, 0.2, { Color = Theme.Accent }) end)
    box.FocusLost:Connect(function(enter)
        tween(boxStroke, 0.2, { Color = Theme.Stroke })
        textbox:Set(box.Text)
        if opts.ClearOnEnter and enter then box.Text = "" end
    end)
    registerFlag(opts.Flag, textbox)
    return textbox
end

-- Keybind -------------------------------------------------------------------
function Section:Keybind(opts)
    local frame = baseElement(self)
    elementLabel(frame, opts.Name or "Keybind", 110)
    local keyButton = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.fromOffset(70, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Font = Enum.Font.GothamBold,
        TextColor3 = Theme.SubText,
        TextSize = 12,
        Parent = frame,
    }, { corner(4), padding(0, 0, 8, 8) })
    local keyStroke = stroke(Theme.Stroke)
    keyStroke.Parent = keyButton

    local keybind = { Value = opts.Default, Frame = frame }
    local listening = false

    local function render()
        keyButton.Text = listening and "..." or (keybind.Value and keybind.Value.Name or "None")
    end
    function keybind:Set(key, silent)
        if typeof(key) == "string" then key = Enum.KeyCode[key] end
        self.Value = key
        render()
        if not silent then safeCall(opts.ChangedCallback, key) end
    end
    function keybind:Get() return self.Value end

    keyButton.MouseButton1Click:Connect(function()
        listening = true
        tween(keyStroke, 0.2, { Color = Theme.Accent })
        render()
    end)

    table.insert(self.Window._conns, UserInputService.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            listening = false
            tween(keyStroke, 0.2, { Color = Theme.Stroke })
            keybind:Set(input.KeyCode ~= Enum.KeyCode.Escape and input.KeyCode or nil)
            return
        end
        if not processed and keybind.Value and input.KeyCode == keybind.Value then
            safeCall(opts.Callback, keybind.Value)
        end
    end))

    render()
    registerFlag(opts.Flag, keybind)
    return keybind
end

