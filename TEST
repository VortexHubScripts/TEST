-- ============================================================================
--  WATERMARK + KEYBIND LIST
-- ============================================================================
--  Both live outside the window so they stay up while it's hidden, and
--  both can be dragged. They start below Roblox's top bar so they don't
--  cover its buttons.
-- ============================================================================
local function topBarHeight()
    local ok, inset = pcall(function() return game:GetService("GuiService"):GetGuiInset() end)
    return ok and inset.Y or 58
end

function Window:SetWatermark(visible)
    if visible and not self._watermark then
        local pill = new("Frame", {
            Position = UDim2.fromOffset(16, topBarHeight() + 10),
            Size = UDim2.fromOffset(0, 26),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Theme.Surface,
            BorderSizePixel = 0,
            Active = true,
            Parent = self.Gui,
        }, {
            corner(6),
            outline(0.88),
            padding(0, 0, 6, 10),
            new("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                VerticalAlignment = Enum.VerticalAlignment.Center,
                Padding = UDim.new(0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder,
            }),
        })
        local logoHolder = new("Frame", {
            Size = UDim2.fromOffset(16, 16),
            BackgroundTransparency = 1,
            LayoutOrder = 1,
            Parent = pill,
        })
        local logo = buildLogo(logoHolder, { Scale = 16 / LOGO_SIZE })
        logo.Holder.Position = UDim2.fromScale(0.5, 0.5)

        local function text(order, font, color)
            return new("TextLabel", {
                Size = UDim2.fromOffset(0, 26),
                AutomaticSize = Enum.AutomaticSize.X,
                BackgroundTransparency = 1,
                FontFace = font,
                TextColor3 = color,
                TextSize = 11,
                LayoutOrder = order,
                Parent = pill,
            })
        end
        text(2, Fonts.Bold, Theme.Text).Text = string.upper(self.Title)
        local function sep(order)
            new("Frame", {
                Size = UDim2.fromOffset(1, 12),
                BackgroundColor3 = Theme.Outline,
                BackgroundTransparency = 0.85,
                BorderSizePixel = 0,
                LayoutOrder = order,
                Parent = pill,
            })
        end
        sep(3)
        local fps = text(4, Fonts.Medium, Theme.SubText)
        sep(5)
        local ping = text(6, Fonts.Medium, Theme.SubText)
        sep(7)
        local clock = text(8, Fonts.Medium, Theme.SubText)
        makeDraggable(pill, pill, self._conns)

        self._watermark = pill
        task.spawn(function()
            while pill.Parent do
                fps.Text = stats.FPS .. " fps"
                ping.Text = stats.Ping .. " ms"
                clock.Text = os.date("%H:%M:%S")
                task.wait(0.5)
            end
        end)
    elseif self._watermark then
        self._watermark.Visible = visible
    end
end

