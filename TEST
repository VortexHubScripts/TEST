-- If launched standalone, ExistingWindow/ExistingCompkiller are nil and we
-- build our own window (own UI). If loaded from another script that passes
-- its own Window/Compkiller in, we attach to that instead (combined UI).
local ExistingWindow, ExistingCompkiller = ...

print("[ExampleTab] ExistingWindow:", ExistingWindow, "type:", type(ExistingWindow))
print("[ExampleTab] ExistingCompkiller:", ExistingCompkiller, "type:", type(ExistingCompkiller))

local Compkiller = ExistingCompkiller or loadstring(game:HttpGet("https://raw.githubusercontent.com/VortexHubScripts/CompKillerBishop/refs/heads/main/v5"))()

if ExistingCompkiller then
	print("[ExampleTab] Using EXISTING Compkiller instance (not creating a new one).")
else
	print("[ExampleTab] No ExistingCompkiller received -- loaded a fresh Compkiller library.")
end

local Window = ExistingWindow or Compkiller.new({
	Name = "COMPKILLER",
	Keybind = "LeftAlt",
	Logo = "rbxassetid://120245531583106",
	Scale = Compkiller.Scale.Window,
	TextSize = 15,
})

if ExistingWindow then
	print("[ExampleTab] Using EXISTING Window (not creating a new one).")
else
	print("[ExampleTab] No ExistingWindow received -- created a brand new Window (this is the bug if you're loading from Bishop Hub).")
end

local ConfigManager = Compkiller:ConfigManager({
	Directory = "Compkiller-UI",
	Config = "Example-Configs",
})

-- Watermark
local Watermark = Window:Watermark()
local Time = Watermark:AddText({
	Icon = "timer",
	Text = "TIME",
})

task.spawn(function()
	while true do task.wait()
		Time:SetText(Compkiller:GetTimeNow())
	end
end)

-- Main Tab and Section
local NormalTab = Window:DrawTab({
	Name = "Example Tab",
	Icon = "apple",
})

local NormalSection = NormalTab:DrawSection({
	Name = "Controls",
	Position = 'left'
})

-- Toggle Button
local Toggle = NormalSection:AddToggle({
	Name = "Feature Toggle",
	Flag = "Toggle_Example",
	Default = false,
	Risky = false,
	Callback = function(state)
		print("Toggle state changed to:", state)
	end,
})

-- Text Input (TextBox)
NormalSection:AddTextBox({
	Name = "Input Text",
	Default = "",
	Placeholder = "Enter text here...",
	Numeric = false,
	Flag = "TextBox_Example",
	Callback = function(text)
		print("TextBox input:", text)
	end,
})

-- Extra Cool Features (Slider, ColorPicker, Button)
NormalSection:AddSlider({
	Name = "Speed Slider",
	Min = 0,
	Max = 100,
	Default = 50,
	Round = 0,
	Flag = "Slider_Example",
	Callback = print,
})

NormalSection:AddColorPicker({
	Name = "Theme Color",
	Default = Color3.fromRGB(0, 255, 140),
	Transparency = 0,
	Flag = "Color_Picker_Example",
	Callback = print,
})

NormalSection:AddButton({
	Name = "Action Button",
	Callback = function()
		print("Button clicked!")
		local Notify = Compkiller.newNotify()
		Notify.new({
			Icon = "bell",
			Title = "Success",
			Content = "Action button was pressed!",
			Duration = 3,
		})
	end,
})

-- Config Tab
local ConfigUI = Window:DrawConfig({
	Name = "Config",
	Icon = "folder",
	Config = ConfigManager,
})

ConfigUI:Init()
